{
  "name": "derek-dileo-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run src",
    "test:watch": "vitest",
    "format": "prettier --write src e2e .github README.md package.json astro.config.mjs playwright.config.ts tsconfig.json",
    "format:check": "prettier --check src e2e .github README.md package.json astro.config.mjs playwright.config.ts tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "astro": "latest",
    "gsap": "^3.15.0",
    "typescript": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "vitest": "^4.1.11"
  }
}
