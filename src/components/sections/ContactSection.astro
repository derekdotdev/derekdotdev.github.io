---
import Icon from "../Icon.astro";
import ResumeLink from "../ResumeLink.astro";

interface Props {
  resumeUrl: string;
}

const { resumeUrl } = Astro.props;
---

<section class="contact container" data-reveal>
  <div id="contact" class="contact__panel">
    <p class="eyebrow">Open to the right opportunity</p>
    <h2>Looking for an Android engineer?</h2>
    <p>
      I’m interested in teams that value thoughtful architecture, polished user
      experiences, and software built to last. If that sounds like yours, I’d
      like to hear from you.
    </p>
    <div class="contact__actions">
      <a class="button button--primary" href="mailto:derekfdileo@gmail.com"
        ><Icon name="mail" /> Send an email</a
      >
      <ResumeLink href={resumeUrl} />
    </div>
  </div>
</section>
