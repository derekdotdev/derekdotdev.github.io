---
import { capabilities } from "../../data/profile";
import Icon from "../Icon.astro";
import { ICON_SIZES } from "../../data/iconSizes";
---

<section class="section container">
  <div id="approach" class="section-heading section-heading--split" data-reveal>
    <div>
      <p class="eyebrow">Engineering approach</p>
      <h2>Built for change.</h2>
    </div>
    <p>
      Architecture should make product development safer and more predictable
      while increasing developer velocity—not add ceremony for its own sake.
    </p>
  </div>

  <div class="capabilities" data-reveal>
    <div class="capabilities__intro">
      <h2>Mobile first.<br />Systems fluent.</h2>
      <p>
        I work across the Android application stack, creating clear boundaries
        and reusable patterns that help engineers ship confidently and move
        faster.
      </p>
      <a
        class="approach-case-study"
        href="/blog/modernizing-android-architecture/"
      >
        Read the AgentStatusCard case study <Icon
          name="arrow"
          size={ICON_SIZES.sm}
        />
      </a>
    </div>
    <div class="capability-grid">
      {
        capabilities.map((capability) => (
          <article>
            <span>{capability.number}</span>
            <h3>{capability.title}</h3>
            <p>{capability.description}</p>
          </article>
        ))
      }
      <p class="capability-grid__additional">
        <span>Additional experience</span> Working knowledge of Kotlin Multiplatform
        and shared cross-platform architecture.
      </p>
    </div>
  </div>
</section>
