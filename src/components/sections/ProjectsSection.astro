---
import ProjectCard from "../ProjectCard.astro";
import { projects } from "../../data/projects";
---

<section class="section section--work container">
  <div id="projects" class="section-heading section-heading--split" data-reveal>
    <div>
      <p class="eyebrow">Selected work</p>
      <h2>Ideas made tangible.</h2>
    </div>
    <p>A selection of mobile, backend, embedded, and civic projects built to explore real problems.</p>
  </div>

  <div class="project-list">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</section>
