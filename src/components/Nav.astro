---
import Icon from "./Icon.astro";
---

<header class="nav-shell">
  <nav class="nav container" aria-label="Main navigation">
    <a class="brand" href="#top">
      <span class="brand__mark" aria-hidden="true">DD</span>
      <span>Derek DiLeo</span>
    </a>
    <div id="mobile-navigation" class="nav__links">
      <a href="#about" data-section-link="about">About</a>
      <a href="#work" data-section-link="work">Work</a>
      <a href="#approach" data-section-link="approach">Approach</a>
      <a href="#contact" data-section-link="contact">Contact</a>
    </div>
    <div class="nav__actions">
      <button
        class="nav__theme-toggle"
        type="button"
        aria-label="Switch to light theme"
        title="Switch to light theme"
      >
        <span class="nav__theme-icon nav__theme-icon--sun"
          ><Icon name="sun" size={18} /></span
        >
        <span class="nav__theme-icon nav__theme-icon--moon"
          ><Icon name="moon" size={18} /></span
        >
      </button>
      <a
        class="nav__github"
        href="https://github.com/derekdotdev"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub profile"
      >
        <Icon name="github" size={18} />
        <span>GitHub</span>
      </a>
      <button
        class="nav__menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        aria-label="Open navigation menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-shell {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    border-bottom: 1px solid transparent;
    transition:
      background 180ms ease,
      border-color 180ms ease;
  }

  .nav-shell.is-scrolled {
    background: var(--color-nav-background);
    border-color: var(--color-line);
    backdrop-filter: blur(18px);
  }

  .nav {
    position: relative;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand,
  .nav__github {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text);
    font-weight: 650;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--color-action-border);
    border-radius: 0.7rem;
    background: linear-gradient(
      145deg,
      var(--color-action-muted),
      var(--color-highlight-muted)
    );
    color: var(--color-action-soft);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  .nav__links {
    display: flex;
    gap: clamp(1.2rem, 3vw, 2.5rem);
  }
  .nav__links a {
    position: relative;
    padding: 0.55rem 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    transition: color 180ms ease;
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--color-action);
    box-shadow: 0 0 10px var(--shadow-action);
    opacity: 0;
    transform: scaleX(0.35);
    transition:
      opacity 180ms ease,
      transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .nav__links a:hover {
    color: var(--color-text);
  }
  .nav__links a.is-active {
    color: var(--color-text);
  }
  .nav__links a.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav__github {
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    padding: 0.62rem 1rem;
    font-size: 0.84rem;
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }
  .nav__github:hover {
    border-color: var(--color-action-border);
    background: var(--color-action-muted);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .nav__theme-toggle,
  .nav__menu-toggle {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.75rem;
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
  }
  .nav__theme-toggle {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0;
  }
  .nav__theme-toggle:hover,
  .nav__menu-toggle:hover {
    border-color: var(--color-action-border);
    background: var(--color-action-muted);
  }
  .nav__theme-icon {
    display: grid;
    place-items: center;
    transition:
      opacity 160ms ease,
      transform 180ms ease;
  }
  .nav__theme-icon--moon {
    position: absolute;
    opacity: 0;
    transform: rotate(-20deg) scale(0.7);
  }
  :global(html[data-theme="light"]) .nav__theme-icon--sun {
    opacity: 0;
    transform: rotate(20deg) scale(0.7);
  }
  :global(html[data-theme="light"]) .nav__theme-icon--moon {
    opacity: 1;
    transform: none;
  }
  .nav__menu-toggle {
    display: none;
    padding: 0.68rem;
  }
  .nav__menu-toggle span {
    display: block;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }
  .nav__menu-toggle span + span {
    margin-top: 4px;
  }
  .nav__menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(5.5px) rotate(45deg);
  }
  .nav__menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  @media (max-width: 640px) {
    .nav {
      height: 66px;
    }
    .nav__links {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 0.65rem;
      border: 1px solid var(--color-line-strong);
      border-radius: 1rem;
      background: var(--color-surface-raised);
      box-shadow: 0 1.5rem 4rem var(--color-shadow);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transition:
        opacity 180ms ease,
        transform 180ms ease,
        visibility 180ms ease;
    }
    .nav__links.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__links a {
      padding: 0.85rem 1rem;
      border-radius: 0.65rem;
    }
    .nav__links a.is-active {
      background: var(--color-action-muted);
    }
    .nav__links a::after {
      display: none;
    }
    .nav__github span {
      display: none;
    }
    .nav__github {
      padding: 0.62rem;
    }
    .nav__menu-toggle {
      display: block;
    }
  }

  @media (max-width: 640px) and (hover: hover) {
    .nav__links a:hover {
      background: var(--color-action-muted);
    }
  }
</style>

<script>
  import { initializeNavigation } from "../scripts/navigation";

  initializeNavigation();
</script>
