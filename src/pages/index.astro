---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import ApproachSection from "../components/sections/ApproachSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import ImpactSection from "../components/sections/ImpactSection.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import resumeUrl from "../assets/derek-dileo-resume.pdf?url";

const title = "Derek DiLeo — Android & Software Engineer";
const description =
  "L3 Android software engineer and UI architecture owner building maintainable applications with Kotlin, Jetpack Compose, MVI, and native C++ integration.";
---

<BaseLayout title={title} description={description}>
  <main id="top">
    <HeroSection {resumeUrl} />
    <AboutSection />
    <ImpactSection />
    <ProjectsSection />
    <ApproachSection />
    <ContactSection {resumeUrl} />
  </main>
  <SiteFooter />
</BaseLayout>
