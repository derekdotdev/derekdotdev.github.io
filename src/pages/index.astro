---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";

const title = "Derek DiLeo — Android & Software Engineer";
const description = "L3 Android software engineer and UI architecture owner building maintainable applications with Kotlin, Jetpack Compose, MVI, and native C++ integration.";
---

<BaseLayout title={title} description={description}>
  <main id="top">
    <section class="hero container">
      <div class="hero__content" data-reveal>
        <p class="availability"><span></span> L3 Software Engineer · UI architecture owner</p>
        <h1>
          <span>I build software</span>
          <span>that feels</span>
          <span><em>considered.</em></span>
        </h1>
        <p class="hero__lede">
          I’m Derek, an Android engineer who defines scalable UI patterns and builds maintainable applications from Compose through the data layer.
        </p>
        <div class="hero__actions">
          <a class="button button--primary" href="#work">Explore my work <Icon name="arrow" /></a>
          <a class="button button--ghost" href="/derek-dileo-resume.pdf" download>
            <Icon name="download" /> Download résumé
          </a>
        </div>
      </div>
      <div class="hero__aside" data-reveal>
        <div class="device-card">
          <div class="device-card__glow"></div>
          <div class="device-card__top"><span></span><span></span></div>
          <div class="device-card__screen">
            <p class="code-label">CURRENT_FOCUS</p>
            <p class="code-value">UI Architecture</p>
            <div class="code-rule"></div>
            <p class="code-label">BUILDING_WITH</p>
            <div class="code-pills"><span>Kotlin</span><span>Compose</span><span>C++ / JNI</span></div>
            <div class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          </div>
        </div>
        <p class="hero__aside-note"><span>01</span> Engineering with product instinct</p>
      </div>
      <a class="scroll-cue" href="#about" aria-label="Scroll to about section"><span></span> Scroll to explore</a>
    </section>

    <section id="about" class="section container">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">A little context</p>
        <h2>More than screens and syntax.</h2>
      </div>
      <div class="about-grid">
        <div class="about-copy" data-reveal>
          <p class="about-copy__lead">
            I build Android systems that remain understandable, testable, and adaptable as products grow.
          </p>
          <p>
            As an L3 Software Engineer and UI architecture owner, I establish scalable patterns with Jetpack Compose, MVI, ViewModels, and Clean Architecture. I maintain clear, dependency-inverted boundaries from the UI and domain layers through Room persistence and JNI-backed C++ integration in the data layer.
          </p>
        </div>
        <div class="principles" data-reveal>
          <article><span>01</span><div><h3>Architecture owner</h3><p>Define UI conventions and boundaries that keep Compose features consistent as the application evolves.</p></div></article>
          <article><span>02</span><div><h3>Loosely coupled</h3><p>Use domain interfaces, dependency inversion, and Hilt to keep responsibilities explicit and replaceable.</p></div></article>
          <article><span>03</span><div><h3>Built to last</h3><p>Apply SOLID principles, clean code, and focused tests to make change safer over the long term.</p></div></article>
        </div>
      </div>
    </section>

    <section id="work" class="section section--work container">
      <div class="section-heading section-heading--split" data-reveal>
        <div><p class="eyebrow">Selected work</p><h2>Ideas made tangible.</h2></div>
        <p>A selection of mobile, backend, embedded, and civic projects built to explore real problems.</p>
      </div>
      <div class="project-list">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </section>

    <section class="section container">
      <div class="capabilities" data-reveal>
        <div class="capabilities__intro">
          <p class="eyebrow">How I build</p>
          <h2>Mobile first.<br />Systems fluent.</h2>
          <p>I work across the Android application stack, treating architecture as a practical tool for making product development safer and more predictable.</p>
        </div>
        <div class="capability-grid">
          <article><span>01</span><h3>UI Architecture</h3><p>Translate product designs into reusable, themed Material 3 components and establish consistent Compose and MVI state patterns across the application.</p></article>
          <article><span>02</span><h3>App Architecture</h3><p>Clean Architecture, SOLID principles, domain interfaces, dependency inversion, and Hilt.</p></article>
          <article><span>03</span><h3>Platform & Data</h3><p>Design lifecycle-aware foreground services for reliable long-running work under Android’s background-execution constraints, with Room persistence and bounded JNI/C++ integration.</p></article>
          <article><span>04</span><h3>Testing & Quality</h3><p>Build confidence with pure Kotlin unit tests, instrumented tests, and automated Jetpack Compose UI tests using JUnit and AssertK.</p></article>
          <p class="capability-grid__additional"><span>Additional experience</span> Working knowledge of Kotlin Multiplatform and shared cross-platform architecture.</p>
        </div>
      </div>
    </section>

    <section id="contact" class="contact container" data-reveal>
      <div class="contact__panel">
        <p class="eyebrow">Let’s connect</p>
        <h2>Have an interesting problem?</h2>
        <p>I’m always open to meeting good people and hearing about thoughtful products, especially in the Android and mobile space.</p>
        <div class="contact__actions">
          <a class="button button--primary" href="mailto:derekfdileo@gmail.com"><Icon name="mail" /> Send an email</a>
          <a class="button button--ghost" href="/derek-dileo-resume.pdf" download><Icon name="download" /> Résumé</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer container">
    <p>Designed and built by Derek DiLeo <span>·</span> <span id="year"></span></p>
    <div><a href="https://github.com/derekdotdev" target="_blank" rel="noreferrer"><Icon name="github" /> GitHub</a><a href="https://www.linkedin.com/in/derek-dileo" target="_blank" rel="noreferrer"><Icon name="linkedin" /> LinkedIn</a></div>
  </footer>

  <script>document.querySelector("#year")!.textContent = String(new Date().getFullYear());</script>
</BaseLayout>
